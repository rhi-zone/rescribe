{
  "description": "Backslash-escaped whitespace disappears, making markup adjacent to a word",
  "category": "rare",
  "assertions": [
    { "path": "/0", "kind": "paragraph" },
    { "path": "/0/0", "kind": "text", "props": { "content": "A star" } },
    { "path": "/0/1", "kind": "emphasis" },
    { "path": "/0/1/0", "kind": "text", "props": { "content": "adjacent" } },
    { "path": "/0/2", "kind": "text", "props": { "content": " to a word." } }
  ]
}
