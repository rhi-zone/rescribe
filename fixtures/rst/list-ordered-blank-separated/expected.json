{
  "description": "Ordered (numbered) list whose items are separated by blank lines still produces one list, not one list per item",
  "category": "happy",
  "assertions": [
    { "path": "/0", "kind": "list", "props": { "ordered": true }, "children_count": 3 },
    { "path": "/0/0", "kind": "list_item" },
    { "path": "/0/0/0", "kind": "paragraph" },
    { "path": "/0/1", "kind": "list_item" },
    { "path": "/0/1/0", "kind": "paragraph" },
    { "path": "/0/2", "kind": "list_item" },
    { "path": "/0/2/0", "kind": "paragraph" }
  ]
}
