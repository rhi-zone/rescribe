{
  "description": "Journal article with cite key, author, title, journal, year, volume, and a numeric page range",
  "category": "happy",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry", "props": { "bibtex:key": "smith2020", "bibtex:entry-type": "article", "date": { "year": 2020 } } },
    { "path": "/0/0/0",   "kind": "bibliography_field", "props": { "field:role": "author", "bibtex:field": "author" } },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "John" } },
    { "path": "/0/0/0/1", "kind": "text", "props": { "content": "Smith" } },
    { "path": "/0/0/1",   "kind": "bibliography_field", "props": { "field:role": "page_first", "bibtex:field": "pages" } },
    { "path": "/0/0/1/0", "kind": "text", "props": { "content": "1" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "page_last", "bibtex:field": "pages" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "10" } },
    { "path": "/0/0/3",   "kind": "bibliography_field", "props": { "field:role": "container_title", "bibtex:field": "journal" } },
    { "path": "/0/0/3/0", "kind": "text", "props": { "content": "Nature" } },
    { "path": "/0/0/4",   "kind": "bibliography_field", "props": { "field:role": "title", "bibtex:field": "title" } },
    { "path": "/0/0/4/0", "kind": "text", "props": { "content": "A Great Paper" } },
    { "path": "/0/0/5",   "kind": "bibliography_field", "props": { "field:role": "volume", "bibtex:field": "volume" } },
    { "path": "/0/0/5/0", "kind": "text", "props": { "content": "42" } }
  ]
}
