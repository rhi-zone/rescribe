{
  "description": "Entry with two authors joined by 'and' becomes two sibling bibliography_field nodes with field:role=author, in document order",
  "category": "happy",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry", "props": { "bibtex:key": "smith2021", "bibtex:entry-type": "article", "date": { "year": 2021 } } },
    { "path": "/0/0/0",   "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "J." } },
    { "path": "/0/0/0/1", "kind": "text", "props": { "content": "Smith" } },
    { "path": "/0/0/1",   "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/1/0", "kind": "text", "props": { "content": "A." } },
    { "path": "/0/0/1/1", "kind": "text", "props": { "content": "Jones" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "container_title", "bibtex:field": "journal" } },
    { "path": "/0/0/3",   "kind": "bibliography_field", "props": { "field:role": "title", "bibtex:field": "title" } }
  ]
}
