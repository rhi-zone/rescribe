{
  "description": "BibTeX @techreport entry becomes bibliography_entry with bibtex:entry-type techreport; institution raw-preserves as misc, number maps to issue",
  "assertions": [
    { "path": "/0",     "kind": "bibliography" },
    { "path": "/0/0",   "kind": "bibliography_entry", "props": { "bibtex:entry-type": "techreport" } },
    { "path": "/0/0/1", "kind": "bibliography_field", "props": { "field:role": "misc", "bibtex:field": "institution" } },
    { "path": "/0/0/2", "kind": "bibliography_field", "props": { "field:role": "issue", "bibtex:field": "number" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "TR-42" } }
  ]
}
