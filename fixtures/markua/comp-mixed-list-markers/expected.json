{
  "description": "A dash-bullet list immediately followed (across a blank line) by a numbered list must parse as two separate list blocks, not be merged into one list tagged with the first item's marker type",
  "category": "integration",
  "assertions": [
    { "path": "/0", "kind": "list", "props": { "ordered": false }, "children_count": 2 },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "alpha" } },
    { "path": "/0/1/0/0", "kind": "text", "props": { "content": "beta" } },
    { "path": "/1", "kind": "list", "props": { "ordered": true }, "children_count": 2 },
    { "path": "/1/0/0/0", "kind": "text", "props": { "content": "first" } },
    { "path": "/1/1/0/0", "kind": "text", "props": { "content": "second" } }
  ]
}
