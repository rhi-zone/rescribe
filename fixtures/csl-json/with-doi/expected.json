{
  "description": "Entry with DOI field becomes an identifier field with field:scheme doi",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry", "props": { "csl:id": "lee2022", "csl:type": "article-journal" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "identifier", "field:scheme": "doi", "csl:field": "DOI" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "10.1000/xyz123" } }
  ]
}
