{
  "description": "Footnote inline element with citation and body",
  "category": "happy",
  "assertions": [
    { "path": "/0", "kind": "paragraph" },
    { "path": "/0/0", "kind": "text", "props": { "content": "Text with a footnote" } },
    { "path": "/0/1", "kind": "footnote_ref", "props": { "label": "ftn1" } },
    { "path": "/1", "kind": "footnote_def", "props": { "label": "ftn1" } },
    { "path": "/1/0/0", "kind": "text", "props": { "content": "This is the footnote text." } }
  ]
}
