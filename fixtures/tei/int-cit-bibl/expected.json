{
  "description": "cit with bibl attribution (quote plus bibliographic reference)",
  "category": "integration",
  "assertions": [
    { "path": "/0",     "kind": "blockquote" },
    { "path": "/0/0",   "kind": "blockquote" },
    { "path": "/0/1",   "kind": "span", "props": { "tei:tag": "bibl" } },
    { "path": "/0/1/1", "kind": "span", "props": { "tei:tag": "title" } }
  ]
}
