{
  "description": "biblStruct with all three levels present: analytic (this chapter's own author/title) flattens into the entry's direct bibliography_field children; monogr (the containing book) and series (the series the book belongs to) each become their own nested bibliography_entry, per the human-approved analytic-flattens/monogr-and-series-nest fork resolution",
  "category": "integration",
  "assertions": [
    { "path": "/0/0",       "kind": "bibliography_entry", "props": { "tei:tag": "biblStruct" }, "children_count": 4 },
    { "path": "/0/0/0",     "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/1",     "kind": "bibliography_field", "props": { "field:role": "title", "tei:attr:level": "a" } },
    { "path": "/0/0/1/0",   "kind": "text", "props": { "content": "Chapter Title" } },
    { "path": "/0/0/2",     "kind": "bibliography_entry", "props": { "tei:tag": "monogr", "date": { "year": 2015 }, "tei:date-attr": "when" }, "children_count": 2 },
    { "path": "/0/0/2/0",   "kind": "bibliography_field", "props": { "field:role": "title", "tei:attr:level": "m" } },
    { "path": "/0/0/2/0/0", "kind": "text", "props": { "content": "Book Title" } },
    { "path": "/0/0/2/1",   "kind": "bibliography_field", "props": { "field:role": "publisher" } },
    { "path": "/0/0/2/1/0", "kind": "text", "props": { "content": "Example Press" } },
    { "path": "/0/0/3",     "kind": "bibliography_entry", "props": { "tei:tag": "series" }, "children_count": 2 },
    { "path": "/0/0/3/0",   "kind": "bibliography_field", "props": { "field:role": "title", "tei:attr:level": "s" } },
    { "path": "/0/0/3/0/0", "kind": "text", "props": { "content": "Great Works Series" } },
    { "path": "/0/0/3/1",   "kind": "bibliography_field", "props": { "field:role": "volume" } },
    { "path": "/0/0/3/1/0", "kind": "text", "props": { "content": "3" } }
  ]
}
