{
  "description": "biblioentry with a single structured author, title, publisher, page range, and DOI identifier becomes a bibliography_entry with bibliography_field children",
  "category": "happy",
  "assertions": [
    { "path": "/0/0",     "kind": "bibliography" },
    { "path": "/0/0/0",   "kind": "bibliography_entry", "props": { "docbook:tag": "biblioentry" }, "children_count": 6 },
    { "path": "/0/0/0/0", "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/0/1", "kind": "bibliography_field", "props": { "field:role": "title" } },
    { "path": "/0/0/0/1/0", "kind": "text", "props": { "content": "A Simple Title" } },
    { "path": "/0/0/0/2", "kind": "bibliography_field", "props": { "field:role": "publisher" } },
    { "path": "/0/0/0/2/0", "kind": "text", "props": { "content": "Acme Press" } },
    { "path": "/0/0/0/3", "kind": "bibliography_field", "props": { "field:role": "page_first" } },
    { "path": "/0/0/0/3/0", "kind": "text", "props": { "content": "12" } },
    { "path": "/0/0/0/4", "kind": "bibliography_field", "props": { "field:role": "page_last" } },
    { "path": "/0/0/0/4/0", "kind": "text", "props": { "content": "34" } },
    { "path": "/0/0/0/5", "kind": "bibliography_field", "props": { "field:role": "identifier", "field:scheme": "doi" } },
    { "path": "/0/0/0/5/0", "kind": "text", "props": { "content": "10.1234/xyz" } }
  ]
}
