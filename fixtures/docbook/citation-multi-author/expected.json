{
  "description": "biblioentry with an authorgroup of two authors becomes two sibling bibliography_field nodes with field:role=author, in document order (not merged or overwritten)",
  "category": "integration",
  "assertions": [
    { "path": "/0/0/0",   "kind": "bibliography_entry", "children_count": 5 },
    { "path": "/0/0/0/0", "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/0/0/0", "kind": "text", "props": { "content": "Jane" } },
    { "path": "/0/0/0/0/1", "kind": "text", "props": { "content": "Doe" } },
    { "path": "/0/0/0/1", "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/0/1/0", "kind": "text", "props": { "content": "John" } },
    { "path": "/0/0/0/1/1", "kind": "text", "props": { "content": "Smith" } },
    { "path": "/0/0/0/2", "kind": "bibliography_field", "props": { "field:role": "title" } },
    { "path": "/0/0/0/3", "kind": "bibliography_field", "props": { "field:role": "volume" } },
    { "path": "/0/0/0/3/0", "kind": "text", "props": { "content": "5" } },
    { "path": "/0/0/0/4", "kind": "bibliography_field", "props": { "field:role": "issue" } },
    { "path": "/0/0/0/4/0", "kind": "text", "props": { "content": "2" } }
  ]
}
