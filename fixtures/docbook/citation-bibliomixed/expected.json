{
  "description": "bibliomixed's mixed free-text/structured content model: plain text interspersed with author/title fields becomes an entry tagged docbook:tag=bibliomixed, with ordinary text nodes and bibliography_field nodes as direct siblings in document order",
  "category": "rare",
  "assertions": [
    { "path": "/0/0/0",   "kind": "bibliography_entry", "props": { "docbook:tag": "bibliomixed" }, "children_count": 5 },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "Some text before. " } },
    { "path": "/0/0/0/1", "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/0/1/0", "kind": "text", "props": { "content": "J. Doe" } },
    { "path": "/0/0/0/2", "kind": "text", "props": { "content": ", " } },
    { "path": "/0/0/0/3", "kind": "bibliography_field", "props": { "field:role": "title" } },
    { "path": "/0/0/0/3/0", "kind": "text", "props": { "content": "A Title" } },
    { "path": "/0/0/0/4", "kind": "text", "props": { "content": ". 2020." } }
  ]
}
