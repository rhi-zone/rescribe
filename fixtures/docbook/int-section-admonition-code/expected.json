{
  "description": "a <section> containing both an admonition and a code block preserves both alongside the heading",
  "category": "integration",
  "assertions": [
    { "path": "/0",   "kind": "div" },
    { "path": "/0/0", "kind": "div" },
    { "path": "/0/0/0", "kind": "heading" },
    { "path": "/0/0/1", "kind": "blockquote", "props": { "docbook:type": "warning" } },
    { "path": "/0/0/2", "kind": "code_block", "props": { "language": "bash", "content": "make install" } }
  ]
}
