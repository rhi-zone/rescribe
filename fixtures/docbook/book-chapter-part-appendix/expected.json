{
  "description": "<book>/<part>/<chapter>/<appendix> each carry their real element identity via docbook:tag on the div, not just a bare untagged div inferred back to sectN/section from heading level on round-trip (a genuine code gap distinct from the ordinary <section> case)",
  "assertions": [
    { "path": "/0",       "kind": "div", "props": { "docbook:tag": "book" } },
    { "path": "/0/0",     "kind": "heading", "props": { "level": 1 } },
    { "path": "/0/0/0",   "kind": "text", "props": { "content": "Book Title" } },
    { "path": "/0/1",     "kind": "div", "props": { "docbook:tag": "part" } },
    { "path": "/0/1/0",   "kind": "heading", "props": { "level": 1 } },
    { "path": "/0/1/0/0", "kind": "text", "props": { "content": "Part One" } },
    { "path": "/0/1/1",   "kind": "div", "props": { "docbook:tag": "chapter" } },
    { "path": "/0/1/1/0", "kind": "heading", "props": { "level": 1 } },
    { "path": "/0/1/1/0/0", "kind": "text", "props": { "content": "Chapter One" } },
    { "path": "/0/1/1/1", "kind": "paragraph" },
    { "path": "/0/1/1/1/0", "kind": "text", "props": { "content": "Chapter text." } },
    { "path": "/0/2",     "kind": "div", "props": { "docbook:tag": "appendix" } },
    { "path": "/0/2/0",   "kind": "heading", "props": { "level": 1 } },
    { "path": "/0/2/0/0", "kind": "text", "props": { "content": "Appendix A" } },
    { "path": "/0/2/1",   "kind": "paragraph" },
    { "path": "/0/2/1/0", "kind": "text", "props": { "content": "Appendix text." } }
  ]
}
