{
  "description": "Each keywords/keyword becomes its own misc bibliography_field, in source order, none dropped",
  "category": "integration",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry" },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "misc", "endnote:field": "keywords/keyword" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "bibliometrics" } },
    { "path": "/0/0/3",   "kind": "bibliography_field", "props": { "field:role": "misc", "endnote:field": "keywords/keyword" } },
    { "path": "/0/0/3/0", "kind": "text", "props": { "content": "citation analysis" } },
    { "path": "/0/0/4",   "kind": "bibliography_field", "props": { "field:role": "misc", "endnote:field": "keywords/keyword" } },
    { "path": "/0/0/4/0", "kind": "text", "props": { "content": "metadata" } }
  ]
}
