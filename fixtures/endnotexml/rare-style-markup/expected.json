{
  "description": "<style> markup inside title/secondary-title becomes real inline nodes (emphasis/strong) rather than flattened text; inter-run whitespace is preserved",
  "category": "rare",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry" },
    { "path": "/0/0/1",   "kind": "bibliography_field", "props": { "field:role": "title" }, "children_count": 3 },
    { "path": "/0/0/1/0", "kind": "text", "props": { "content": "A " } },
    { "path": "/0/0/1/1", "kind": "emphasis", "children_count": 1 },
    { "path": "/0/0/1/1/0", "kind": "text", "props": { "content": "Great" } },
    { "path": "/0/0/1/2", "kind": "text", "props": { "content": " Paper" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "container_title" } },
    { "path": "/0/0/2/0", "kind": "strong", "children_count": 1 },
    { "path": "/0/0/2/0/0", "kind": "text", "props": { "content": "Nature" } }
  ]
}
