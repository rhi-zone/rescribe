{
  "description": "Journal article record becomes a bibliography_entry with author/title/container_title/volume/page_first/page_last fields",
  "category": "happy",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry", "props": { "endnote:type": "17", "endnote:key": "smith2020", "date": { "year": 2020 } } },
    { "path": "/0/0/0",   "kind": "bibliography_field", "props": { "field:role": "author", "endnote:field": "authors/author" } },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "Smith, John" } },
    { "path": "/0/0/1",   "kind": "bibliography_field", "props": { "field:role": "title", "endnote:field": "titles/title" } },
    { "path": "/0/0/1/0", "kind": "text", "props": { "content": "A Great Paper" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "container_title", "endnote:field": "titles/secondary-title" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "Nature" } },
    { "path": "/0/0/3",   "kind": "bibliography_field", "props": { "field:role": "volume" } },
    { "path": "/0/0/4",   "kind": "bibliography_field", "props": { "field:role": "page_first" } },
    { "path": "/0/0/4/0", "kind": "text", "props": { "content": "1" } },
    { "path": "/0/0/5",   "kind": "bibliography_field", "props": { "field:role": "page_last" } },
    { "path": "/0/0/5/0", "kind": "text", "props": { "content": "10" } }
  ]
}
