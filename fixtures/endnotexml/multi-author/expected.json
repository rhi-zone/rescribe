{
  "description": "Multiple author elements become sibling bibliography_field nodes with field:role=author, in document order",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry" },
    { "path": "/0/0/0",   "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "Smith, John" } },
    { "path": "/0/0/1",   "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/1/0", "kind": "text", "props": { "content": "Jones, Alice" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "author" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "Brown, Bob" } }
  ]
}
