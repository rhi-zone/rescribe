{
  "description": "integration: a <fig> containing a nested <supplementary-material> (in addition to its own caption/graphic) round-trips each child through its own mapping without one clobbering another",
  "category": "integration",
  "assertions": [
    { "path": "/0",         "kind": "div" },
    { "path": "/0/0",       "kind": "figure", "props": { "id": "f1" } },
    { "path": "/0/0/0",     "kind": "figcaption" },
    { "path": "/0/0/0/0",   "kind": "paragraph" },
    { "path": "/0/0/1",     "kind": "image", "props": { "url": "fig1.png" } },
    { "path": "/0/0/2",     "kind": "div", "props": { "jats:tag": "supplementary-material" } },
    { "path": "/0/0/2/0",   "kind": "figcaption" },
    { "path": "/0/0/2/0/0", "kind": "paragraph" }
  ]
}
