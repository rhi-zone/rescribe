    { "path": "/0/0",       "kind": "figure" },
    { "path": "/0/0/0",     "kind": "table" },
    { "path": "/0/0/0/0",   "kind": "table_body" },
    { "path": "/0/0/0/0/0", "kind": "table_row" },
    { "path": "/0/0/0/0/0/0", "kind": "table_cell" },
    { "path": "/0/0/0/0/0/0/1", "kind": "strong" },
    { "path": "/0/0/0/0/0/0/1/0", "kind": "text", "props": { "content": "bold" } }
  ]
}
