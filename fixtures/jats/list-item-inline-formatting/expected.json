{
  "description": "integration: inline formatting (<italic>) inside a <list-item>'s <p> converts correctly through the nested list -> list_item -> paragraph -> emphasis chain",
  "category": "integration",
  "assertions": [
    { "path": "/0",         "kind": "div" },
    { "path": "/0/0",       "kind": "list" },
    { "path": "/0/0/0",     "kind": "list_item" },
    { "path": "/0/0/0/0",   "kind": "paragraph" },
    { "path": "/0/0/0/0/1", "kind": "emphasis" },
    { "path": "/0/0/0/0/1/0", "kind": "text", "props": { "content": "emphasized" } }
  ]
}
