{
  "description": "DOCX <w:br> with no type produces a line_break node between text runs",
  "category": "happy",
  "assertions": [
    { "path": "/",     "kind": "document" },
    { "path": "/0",    "kind": "paragraph" },
    { "path": "/0/0",  "kind": "text", "props": { "content": "before" } },
    { "path": "/0/1",  "kind": "line_break" },
    { "path": "/0/2",  "kind": "text", "props": { "content": "after" } }
  ]
}
