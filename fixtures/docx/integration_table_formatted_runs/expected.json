{
  "description": "Bold run inside a table cell",
  "category": "integration",
  "assertions": [
    { "path": "/",           "kind": "document" },
    { "path": "/0",          "kind": "table" },
    { "path": "/0/0",        "kind": "table_row" },
    { "path": "/0/0/0",      "kind": "table_cell" },
    { "path": "/0/0/0/0",    "kind": "paragraph" },
    { "path": "/0/0/0/0/0",  "kind": "strong" },
    { "path": "/0/0/0/0/0/0","kind": "text", "props": { "content": "bold cell text" } }
  ]
}
