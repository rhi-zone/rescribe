{
  "description": "DOCX <w:del> tracked deletion is kept (not silently dropped -- the previous reader behavior) and wrapped in a span carrying docx:tracked-change=\"del\" plus author/date/id, so a writer can restore the <w:del> structure",
  "category": "happy",
  "assertions": [
    { "path": "/",     "kind": "document" },
    { "path": "/0",    "kind": "paragraph" },
    { "path": "/0/0",  "kind": "text", "props": { "content": "Unchanged text. " } },
    {
      "path": "/0/1",
      "kind": "span",
      "props": {
        "docx:tracked-change": "del",
        "docx:tracked-change-id": 2,
        "docx:tracked-change-author": "Jane Doe",
        "docx:tracked-change-date": "2026-01-01T00:00:00Z"
      }
    },
    { "path": "/0/1/0", "kind": "text", "props": { "content": "Deleted text." } }
  ]
}
