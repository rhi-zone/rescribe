{
  "description": "Bold run inside a hyperlink",
  "category": "integration",
  "assertions": [
    { "path": "/",       "kind": "document" },
    { "path": "/0",      "kind": "paragraph" },
    { "path": "/0/0",    "kind": "link", "props": { "url": "https://example.com" } },
    { "path": "/0/0/0",  "kind": "strong" },
    { "path": "/0/0/0/0","kind": "text", "props": { "content": "bold link text" } }
  ]
}
