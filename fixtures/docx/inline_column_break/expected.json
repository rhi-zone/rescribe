{
  "description": "DOCX <w:br w:type=\"column\"> produces a line_break node flagged as a column break",
  "category": "happy",
  "assertions": [
    { "path": "/",     "kind": "document" },
    { "path": "/0",    "kind": "paragraph" },
    { "path": "/0/0",  "kind": "text", "props": { "content": "before" } },
    { "path": "/0/1",  "kind": "line_break", "props": { "layout:column": true } },
    { "path": "/0/2",  "kind": "text", "props": { "content": "after" } }
  ]
}
