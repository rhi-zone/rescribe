{
  "description": "DOCX pStyle Heading1..Heading6 each produce a heading node with the matching level",
  "category": "happy",
  "assertions": [
    { "path": "/",     "kind": "document" },
    { "path": "/0",    "kind": "heading", "props": { "level": 1 } },
    { "path": "/0/0",  "kind": "text", "props": { "content": "Heading level 1" } },
    { "path": "/1",    "kind": "heading", "props": { "level": 2 } },
    { "path": "/1/0",  "kind": "text", "props": { "content": "Heading level 2" } },
    { "path": "/2",    "kind": "heading", "props": { "level": 3 } },
    { "path": "/2/0",  "kind": "text", "props": { "content": "Heading level 3" } },
    { "path": "/3",    "kind": "heading", "props": { "level": 4 } },
    { "path": "/3/0",  "kind": "text", "props": { "content": "Heading level 4" } },
    { "path": "/4",    "kind": "heading", "props": { "level": 5 } },
    { "path": "/4/0",  "kind": "text", "props": { "content": "Heading level 5" } },
    { "path": "/5",    "kind": "heading", "props": { "level": 6 } },
    { "path": "/5/0",  "kind": "text", "props": { "content": "Heading level 6" } }
  ]
}
