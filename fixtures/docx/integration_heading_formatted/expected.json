{
  "description": "Bold run inside a heading",
  "category": "integration",
  "assertions": [
    { "path": "/",     "kind": "document" },
    { "path": "/0",    "kind": "heading", "props": { "level": 1 } },
    { "path": "/0/0",  "kind": "strong" },
    { "path": "/0/0/0","kind": "text", "props": { "content": "Bold Heading" } }
  ]
}
