{
  "description": "Journal article with type, author, title, journal, year",
  "category": "happy",
  "assertions": [
    { "path": "/0",       "kind": "bibliography" },
    { "path": "/0/0",     "kind": "bibliography_entry", "props": { "ris:type": "JOUR", "ris:key": "smith2020", "date": { "year": 2020 } } },
    { "path": "/0/0/0",   "kind": "bibliography_field", "props": { "field:role": "author", "ris:field": "AU" } },
    { "path": "/0/0/0/0", "kind": "text", "props": { "content": "Smith, John" } },
    { "path": "/0/0/1",   "kind": "bibliography_field", "props": { "field:role": "title", "ris:field": "TI" } },
    { "path": "/0/0/1/0", "kind": "text", "props": { "content": "A Great Paper" } },
    { "path": "/0/0/2",   "kind": "bibliography_field", "props": { "field:role": "container_title", "ris:field": "JO" } },
    { "path": "/0/0/2/0", "kind": "text", "props": { "content": "Nature" } }
  ]
}
