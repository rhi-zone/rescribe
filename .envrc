if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi
use flake

# Sharing one target/ dir across the main checkout and every git worktree
# of this repo is NOT handled by direnv/nix -- there is no shellHook for it
# here or in flake.nix. It's handled at the filesystem level: each
# worktree's target/ is a symlink (junction on windows) to the main
# checkout's target/, created by the .githooks/post-checkout hook
# (confirmed to fire on `git worktree add`) or manually via
# scripts/setup-worktree-target.sh / .ps1 -- see those scripts and
# CLAUDE.md's "Development" section for details. This applies regardless
# of direnv/nix, so there is nothing for this file to do about it.
