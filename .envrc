if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi
use flake

# Share one target/ dir across the main checkout and every git worktree of
# this repo (including .claude/worktrees/* used by background agents),
# instead of each worktree accumulating its own multi-GB target/.
# `git rev-parse --git-common-dir` always resolves to the *same* shared
# .git directory regardless of which worktree (and which commit's .envrc)
# runs this, so — unlike a path baked into a git-tracked file — this stays
# correct for every future worktree too, not just the ones that already
# exist. Cargo already mutexes concurrent builds against a shared target
# dir via target/.cargo-lock (shared lock for reads, exclusive for writes),
# so this only serializes builds across worktrees rather than
# parallelizing them. Set CARGO_TARGET_DIR yourself before direnv loads to
# override.
if git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null); then
  # git-common-dir is relative to CWD when run from the main checkout but
  # absolute when run from a linked worktree — realpath normalizes both so
  # the exported env var doesn't silently go stale if the shell later cd's
  # elsewhere.
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$(dirname "$(realpath "$git_common_dir")")/target}"
fi
