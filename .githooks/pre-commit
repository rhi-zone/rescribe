#!/usr/bin/env bash
set -e

# Edition comes from rustfmt.toml now; rustfmt version comes from rust-toolchain.toml
# via the flake's dev shell (see flake.nix). Both must be used through `nix develop`
# (or direnv) so this matches what CI and other contributors produce.
STAGED_RS="$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')"
if [ -n "$STAGED_RS" ]; then
  echo "Formatting staged Rust files..."
  echo "$STAGED_RS" | xargs -r rustfmt
  echo "$STAGED_RS" | xargs -r git add --
else
  echo "No staged Rust files — skipping rustfmt."
fi

echo "Running cargo clippy..."
cargo clippy --all-targets --all-features -- -D warnings

echo "Pre-commit checks passed!"
